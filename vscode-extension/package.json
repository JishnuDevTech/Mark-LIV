{
  "name": "jarvis-vscode",
  "displayName": "JARVIS Native Assistant",
  "description": "Native VS Code integration for the existing JARVIS dashboard bridge.",
  "version": "0.1.0",
  "publisher": "jarvis",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other", "Machine Learning"],
  "activationEvents": ["onStartupFinished"],
  "main": "./dist/extension.js",
  "scripts": { "build": "tsc -p .", "compile": "tsc -p .", "watch": "tsc -w -p .", "test": "npm run compile" },
  "devDependencies": { "@types/node": "^20.0.0", "@types/vscode": "^1.85.0", "typescript": "^5.3.0" },
  "contributes": {
    "commands": [
      {"command":"jarvis.openAssistant","title":"JARVIS: Open Assistant"},{"command":"jarvis.analyzeWorkspace","title":"JARVIS: Analyze Workspace"},{"command":"jarvis.explainSelection","title":"JARVIS: Explain Selection"},{"command":"jarvis.reviewFile","title":"JARVIS: Review File"},{"command":"jarvis.reviewChanges","title":"JARVIS: Review Changes"},{"command":"jarvis.fixDiagnostics","title":"JARVIS: Fix Diagnostics"},{"command":"jarvis.runTests","title":"JARVIS: Run Tests"},{"command":"jarvis.runBuild","title":"JARVIS: Run Build"},{"command":"jarvis.showProjectContext","title":"JARVIS: Show Project Context"},{"command":"jarvis.continueTask","title":"JARVIS: Continue Task"},{"command":"jarvis.stopCurrentTask","title":"JARVIS: Stop Current Task"}
    ],
    "viewsContainers": {"activitybar":[{"id":"jarvis","title":"JARVIS","icon":"resources/jarvis.svg"}]},
    "views": {"jarvis":[{"type":"webview","id":"jarvis.assistant","name":"Assistant"}]},
    "configuration": {"title":"JARVIS","properties": {
      "jarvis.coreEndpoint":{"type":"string","default":"http://127.0.0.1:8000","description":"Existing JARVIS dashboard HTTP bridge endpoint."},
      "jarvis.authToken":{"type":"string","default":"","description":"Bearer token for the JARVIS bridge.","scope":"machine","markdownDescription":"Bearer token used for bridge requests."},
      "jarvis.indexing":{"type":"boolean","default":true,"description":"Index workspace files incrementally."},
      "jarvis.contextFileLimit":{"type":"number","default":20,"minimum":1,"maximum":200,"description":"Maximum files included in concise project context."},
      "jarvis.autoBackgroundAnalysis":{"type":"boolean","default":false,"description":"Allow background analysis after file changes."},
      "jarvis.logLevel":{"type":"string","enum":["error","warn","info","debug"],"default":"info","description":"Extension log verbosity."}
    }}
  }
}
