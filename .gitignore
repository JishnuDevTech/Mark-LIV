# ── MARK LIII — what never belongs in the repository ──────────────────────────
# Everything listed here is created by the app on first run. A fresh clone with
# none of it present boots straight to the setup screen, which is the intended
# first experience — so nothing here needs to be committed, and some of it must
# never be.

# ── Secrets. Committing any of these publishes them. ──────────────────────────
config/api_keys.json
config/certs/
config/phone_devices.json
config/*.json
config/whatsapp_web/
**/token*.json
**/client_secret*.json
*credentials*.json
.env
.env.*
android-companion/local.properties

# ── Personal data the assistant accumulates about you ─────────────────────────
memory/long_term.json
memory/*.db
memory/jarvis_state.json
memory/events.json
memory/productivity.json
memory/workspace_notes.json
memory/runtime_state.json
memory/agent_memory.json

# ── Python build noise ────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/
*.vsix

# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Editors and operating systems ─────────────────────────────────────────────
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
android-companion/.gradle/
android-companion/app/build/

# ── Runtime output ────────────────────────────────────────────────────────────
*.log
logs/
downloads/
screenshots/
